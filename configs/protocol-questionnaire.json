{
  "source": "Учебный порядок вопросов по форме (требует согласования с врачом)",
  "questions": [
    {
      "field": "patient_name",
      "include_in_review": false,
      "prompt": "Как вас зовут? Назовите фамилию, имя и отчество.",
      "patterns": ["как вас зовут", "фамили[яю]|имя.*отчеств"],
      "raw_question": "\\b(?:как вас зовут|назовите фамилию имя и отчество)\\b"
    },
    {
      "field": "birth_date",
      "include_in_review": false,
      "prompt": "Какая у вас дата рождения?",
      "patterns": ["дат[ау] рождения", "когда.*родил", "какого.*родил"],
      "raw_question": "\\b(?:какая у вас дата рождения|когда вы родились|назовите дату рождения)\\b"
    },
    {
      "field": "complaints",
      "prompt": "Что вас сейчас беспокоит?",
      "patterns": ["беспокоит|беспокоят|жалуетесь|жалобы", "(?:что|где).*болит"],
      "raw_question": "\\b(?:что (?:вас )?(?:сейчас )?беспокоит|на что (?:вы )?жалуетесь|где (?:у вас )?болит)\\b"
    },
    {
      "field": "illness",
      "prompt": "Когда появились симптомы?",
      "patterns": ["(?:когда|давно|с каких пор).*(?:появи|нача|бол|симптом|беспокои|заметил)", "как давно"],
      "raw_question": "\\bкогда (?:вы это заметили|(?:появил(?:ся|ась|ись)|начал(?:ся|ась|ись)) (?:боль|симптомы|жалобы|тошнота|кашель|головокружение)|(?:он|она) (?:появил(?:ся|ась)|начал(?:ся|ась)))\\b"
    },
    {
      "field": "complaints",
      "prompt": "Если есть боль, насколько она сильная?",
      "when_value_contains": "\\bбол(?:ь|и|ит|ят|ело|евой|евые|езненность)\\b",
      "patterns": ["насколько.*(?:сильн|бол)", "по шкале|оцените.*бол|сил[ау].*бол"],
      "raw_question": "\\bнасколько (?:сильная боль|сильно (?:у вас )?болит)(?: по шкале(?: от (?:нуля|0) до (?:десяти|10))?)?\\b"
    },
    {
      "field": "illness",
      "prompt": "Что усиливает или облегчает симптомы?",
      "patterns": ["усилива|облегча|становится.*(?:лучше|хуже|легче)", "как.*измен"],
      "direct_answer": "усилива|облегча|становится.*(?:лучше|хуже|легче)"
    },
    {
      "field": "life",
      "prompt": "Есть ли хронические заболевания или были операции?",
      "patterns": ["хроническ|оперировали|были.*операци|переносили.*операци"]
    },
    {
      "field": "past_diseases",
      "prompt": "Какие заболевания вы перенесли?",
      "patterns": ["(?:заболеван|болезн).*(?:перенес|перенесли)", "(?:перенес|перенесли).*(?:заболеван|болезн)|чем.*болели"]
    },
    {
      "field": "medicines",
      "prompt": "Какие лекарства вы сейчас принимаете?",
      "patterns": ["(?:препарат|лекарств|таблет).*(?:принима|пьете)", "(?:принима|пьете).*(?:препарат|лекарств|таблет)"]
    },
    {
      "field": "implants",
      "prompt": "Есть ли у вас имплантированные устройства?",
      "patterns": ["имплант|кардиостимулятор|протез"]
    },
    {
      "field": "allergies",
      "prompt": "Есть ли у вас аллергия? Если есть, на что и какая была реакция?",
      "patterns": ["аллерги", "реакци.*(?:лекарств|препарат)"],
      "raw_question": "\\bесть ли (?:у вас )?аллергия(?: на (?:лекарства|препараты))?\\b",
      "incomplete_answer": "^(?:да[,. ]+)?(?:у меня )?(?:аллергия есть|есть аллергия|есть)\\W*$"
    }
  ]
}
